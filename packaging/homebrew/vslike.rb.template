# Homebrew cask for VsLike, rendered by render-cask.sh into Casks/vslike.rb of LaJuMiRa/homebrew-tap.
cask "vslike" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/LaJuMiRa/vslike/releases/download/v#{version}/VsLike-#{version}-arm64.zip"
  name "VsLike"
  desc "Native C# IDE with Roslyn IntelliSense, class diagrams, StyleCop, terminal and debugger"
  homepage "https://github.com/LaJuMiRa/vslike"

  depends_on arch: :arm64
  depends_on macos: ">= :tahoe"

  app "VsLike.app"

  uninstall quit: "io.github.lajumira.vslike"

  zap trash: [
    "~/Library/Caches/VsLike",
    "~/Library/Preferences/io.github.lajumira.vslike.plist",
    "~/Library/Saved Application State/io.github.lajumira.vslike.savedState",
  ]

  caveats <<~EOS
    VsLike needs an installed .NET SDK (10.0 or newer) to load, build and debug projects:
      brew install --cask dotnet-sdk
    The start screen shows whether a suitable SDK was found.

    VsLike is ad-hoc signed but not notarized by Apple, so macOS blocks the first start.
    Either allow it in
      System Settings > Privacy & Security > "Open Anyway"
    or remove the quarantine flag once:
      xattr -dr com.apple.quarantine "#{appdir}/VsLike.app"
  EOS
end
