root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,axaml,json,yml,yaml,resx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# Dokumentationspflicht: nur öffentliche API über Core-Interfaces, keine XML-Doku-Pflicht pro Element
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1633.severity = none
# Feldnamen mit _ und ohne this.
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1010.severity = none
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1000.severity = none

# Protocol messages of the engine: many small records belong together in one file per area.
[src/VsLike.Engine/Protocol/*.cs]
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1649.severity = none
