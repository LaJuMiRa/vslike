<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UsesMSBuildLocator>true</UsesMSBuildLocator>
    <RootNamespace>VsLike.Engine</RootNamespace>
    <AssemblyName>VsLikeEngine</AssemblyName>
    <!-- Runs on .NET 10 when installed, otherwise on the next newer runtime (a machine with only SDK 11 has no runtime 10). -->
    <RollForward>Major</RollForward>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VsLike.Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VsLike.Core\VsLike.Core.csproj" />
    <ProjectReference Include="..\VsLike.Roslyn\VsLike.Roslyn.csproj" />
    <ProjectReference Include="..\VsLike.Diagram\VsLike.Diagram.csproj" />
  </ItemGroup>
</Project>
