<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:VsLike.App.Shell"
             xmlns:l="using:VsLike.App.Localization"
             x:Class="VsLike.App.Shell.WelcomeView"
             x:DataType="shell:WelcomeViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
    <TextBlock Classes="h1" Text="{l:Loc Welcome.Title}" HorizontalAlignment="Center" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Border Classes="kbd"><TextBlock Text="{Binding PaletteChord}" FontFamily="{DynamicResource VsMonoFont}" /></Border>
      <TextBlock Classes="muted" Text="{l:Loc Command.Palette}" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
