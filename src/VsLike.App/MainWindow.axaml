<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:VsLike.App.Shell"
        xmlns:l="using:VsLike.App.Localization"
        xmlns:b="using:VsLike.App.Build"
        x:Class="VsLike.App.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="VsLike"
        MinWidth="720" MinHeight="480">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu x:Name="InWindowMenu" Grid.Row="0" IsVisible="False" />
    <Border x:Name="Toolbar" Grid.Row="1" Classes="toolbar" x:DataType="b:BuildController">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="ConfigurationBox" MinWidth="96" ToolTip.Tip="{l:Loc Build.Configuration}"
                  ItemsSource="{x:Static b:BuildController.Configurations}"
                  SelectedItem="{Binding Configuration}" IsEnabled="{Binding !IsBusy}" />
        <ComboBox x:Name="StartupBox" MinWidth="160" ToolTip.Tip="{l:Loc Run.StartupProject}"
                  ItemsSource="{Binding StartupProjects}"
                  SelectedItem="{Binding StartupProject}" IsEnabled="{Binding !IsBusy}" />
        <ComboBox x:Name="ProfileBox" MinWidth="140" ToolTip.Tip="{l:Loc Run.Profile}"
                  ItemsSource="{Binding LaunchProfiles}"
                  SelectedItem="{Binding LaunchProfile}" IsEnabled="{Binding !IsBusy}" />
        <Button x:Name="RunButton" Classes="accent" IsEnabled="{Binding CanRun}" ToolTip.Tip="{l:Loc Command.Run.Start}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="▶" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="{l:Loc Command.Run.Start}" />
          </StackPanel>
        </Button>
        <Button x:Name="StopButton" IsEnabled="{Binding IsBusy}" ToolTip.Tip="{l:Loc Command.Run.Stop}">
          <TextBlock Text="■" FontSize="11" />
        </Button>
        <Button x:Name="BuildButton" IsEnabled="{Binding CanBuild}" Content="{l:Loc Command.Build.Solution}" />
        <StackPanel x:Name="DebugBar" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
          <Button x:Name="DebugButton" ToolTip.Tip="F5" Content="{l:Loc Command.Debug.Start}" />
          <Button x:Name="StepOverButton" ToolTip.Tip="F10" Content="{l:Loc Debug.StepOverShort}" />
          <Button x:Name="StepIntoButton" ToolTip.Tip="F11" Content="{l:Loc Debug.StepIntoShort}" />
          <Button x:Name="StepOutButton" ToolTip.Tip="⇧F11" Content="{l:Loc Debug.StepOutShort}" />
          <Button x:Name="DebugStopButton" ToolTip.Tip="⇧F5" Content="{l:Loc Command.Debug.Stop}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <DockControl x:Name="DockHost" Grid.Row="2"
                 Layout="{Binding Layout}"
                 Factory="{Binding Factory}"
                 InitializeFactory="True"
                 InitializeLayout="False" />
    <Border Grid.Row="3" Classes="statusbar">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding AnalyzerText}" Margin="0,0,16,0" />
        <TextBlock Grid.Column="2" Text="{Binding ProblemsText}" Margin="0,0,16,0" />
        <TextBlock Grid.Column="3" Text="{Binding CaretText}" />
      </Grid>
    </Border>

    <Panel x:Name="PaletteOverlay" Grid.Row="0" Grid.RowSpan="4"
           IsVisible="{Binding Palette.IsOpen}" Background="#30000000">
      <Border Classes="palette" Width="640" MaxHeight="440" VerticalAlignment="Top" Margin="16,72,16,0">
        <DockPanel>
          <TextBox x:Name="PaletteInput" DockPanel.Dock="Top" Classes="palette"
                   Text="{Binding Palette.Query}" Watermark="{l:Loc Palette.Placeholder}" />
          <Separator DockPanel.Dock="Top" Margin="0" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="16,12"
                     IsVisible="{Binding Palette.HasNoResults}" Text="{l:Loc Palette.NoResults}" />
          <ListBox x:Name="PaletteList" Classes="palette" Margin="6"
                   ItemsSource="{Binding Palette.Items}"
                   SelectedItem="{Binding Palette.SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="shell:PaletteItem">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="muted" Text="{Binding Category, StringFormat='{}{0}:'}" />
                    <TextBlock Text="{Binding Title}" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="kbd" IsVisible="{Binding Chord, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Chord}" FontSize="11" FontFamily="{DynamicResource VsMonoFont}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Panel>
  </Grid>
</Window>
