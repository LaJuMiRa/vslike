<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:VsLike.App.Shell"
             x:Class="VsLike.App.App"
             Name="VsLike">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VsLike/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#B4741A" RegionColor="#F5F5F2" />
        <ColorPaletteResources x:Key="Dark" Accent="#E2A63B" RegionColor="#15171C" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <DockFluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://VsLike/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.DataTemplates>
    <shell:ViewLocator />
  </Application.DataTemplates>
</Application>
