<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:VsLike.App.Shell"
             xmlns:l="using:VsLike.App.Localization"
             x:Class="VsLike.App.App"
             Name="VsLike">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VsLike/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <DockFluentTheme />
    <StyleInclude Source="avares://VsLike/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="shell:PanelViewModel">
      <ContentControl Content="{Binding Content}" />
    </DataTemplate>
    <DataTemplate DataType="shell:EmptyPanelViewModel">
      <TextBlock Classes="muted" Text="{l:Loc Panel.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>
    <DataTemplate DataType="shell:WelcomeViewModel">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Classes="h1" Text="{l:Loc Welcome.Title}" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Border Classes="kbd"><TextBlock Text="{Binding PaletteChord}" FontFamily="{DynamicResource VsMonoFont}" /></Border>
          <TextBlock Classes="muted" Text="{l:Loc Command.Palette}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
