<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="using:VsLike.App.References"
             xmlns:s="using:VsLike.App.Search"
             x:Class="VsLike.App.References.ReferencesView"
             x:DataType="r:ReferencesViewModel">
  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding Summary}" Margin="0,0,0,6" />
    <TreeView x:Name="ResultTree" ItemsSource="{Binding Results}" Background="Transparent">
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="s:SearchResultFile" ItemsSource="{Binding Matches}">
          <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold" />
        </TreeDataTemplate>
        <DataTemplate DataType="s:SearchResultLine">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" Text="{Binding Location}" FontFamily="{DynamicResource VsMonoFont}" FontSize="12" />
            <TextBlock Text="{Binding Preview}" FontFamily="{DynamicResource VsMonoFont}" FontSize="12" />
          </StackPanel>
        </DataTemplate>
      </TreeView.DataTemplates>
      <TreeView.Styles>
        <Style Selector="TreeViewItem">
          <Setter Property="IsExpanded" Value="True" />
        </Style>
      </TreeView.Styles>
    </TreeView>
  </DockPanel>
</UserControl>
