<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ex="using:VsLike.App.Explorer"
             xmlns:l="using:VsLike.App.Localization"
             x:Class="VsLike.App.Explorer.ExplorerView"
             x:DataType="ex:ExplorerViewModel">
  <Panel>
    <TextBlock Classes="muted" Text="{l:Loc Explorer.NoFolder}" IsVisible="{Binding !HasFolder}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" IsVisible="{Binding HasFolder}" Background="Transparent">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="ex:FileNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="MinHeight" Value="24" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="ex:FileNodeViewModel" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Icon}" Classes="muted" FontSize="11" MinWidth="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Panel>
</UserControl>
