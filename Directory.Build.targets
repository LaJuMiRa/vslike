<Project>
  <!-- MSBuild-Assemblies kommen zur Laufzeit über Microsoft.Build.Locator aus dem installierten SDK. -->
  <ItemGroup Condition="'$(UsesMSBuildLocator)' == 'true'">
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Keine Telemetrie: Avalonia.BuildServices sendet sonst Build-Statistiken (Target AvaloniaStats). -->
  <Target Name="AvaloniaStats" />
</Project>
