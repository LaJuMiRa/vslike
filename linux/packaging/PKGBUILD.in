# Maintainer: VsLike contributors
# Binary package for Arch Linux: repackages the tarball of the GitHub release (built by linux/build-linux.sh).
# Template: linux/packaging/build-arch.sh fills in version and checksums (__VERSION__, __SHA256_X64__, __SHA256_ARM64__).
pkgname=vslike-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc="C# and .NET IDE with class diagrams, StyleCop and debugger"
arch=('x86_64' 'aarch64')
url="https://github.com/LaJuMiRa/vslike"
license=('MIT')
depends=('dotnet-sdk' 'fontconfig' 'libx11' 'libice' 'libsm' 'libxcursor' 'libxi' 'libxrandr' 'hicolor-icon-theme' 'shared-mime-info')
provides=('vslike')
conflicts=('vslike')
options=('!strip' '!debug')
source_x86_64=("https://github.com/LaJuMiRa/vslike/releases/download/linux-v${pkgver}/vslike-${pkgver}-linux-x64.tar.gz")
source_aarch64=("https://github.com/LaJuMiRa/vslike/releases/download/linux-v${pkgver}/vslike-${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=('__SHA256_X64__')
sha256sums_aarch64=('__SHA256_ARM64__')

package() {
    cp -a "${srcdir}/usr" "${pkgdir}/"
}
